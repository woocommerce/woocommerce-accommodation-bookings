{
    "name": "woocommerce/woocommerce-accommodation-bookings",
    "description": "An accommodations add-on for the WooCommerce Bookings extension.",
    "homepage": "https://woocommerce.com/products/woocommerce-accommodation-bookings/",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://github.com/woocommerce/.github/releases/download/v1.0.0",
            "only": [ "woocommerce/extension-checks" ]
        }
    ],
    "require-dev": {
        "woocommerce/extension-checks": "1.0.0",
        "woocommerce/woocommerce-sniffs": "1.0.1",
        "phpunit/phpunit": "^9.6",
        "10up/wp_mock": "^1.0.1",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/woocommerce-stubs": "^11.2",
        "yoast/phpunit-polyfills": "^1.1",
        "automattic/jetpack-changelogger": "^6.0"
    },
    "autoload-dev": {
        "classmap": [
            "tools/changelogger/"
        ]
    },
    "scripts": {
        "lint:php": [
            "Composer\\Config::disableProcessTimeout",
            "phpcs"
        ],
        "lint:phpcs:baseline": "bash bin/extension-tooling.sh phpcs.sh",
        "lint:phpcs:baseline:update": "bash bin/extension-tooling.sh phpcs-baseline.sh",
        "check:php": [
            "@composer --working-dir=tools/php-quality install --no-interaction --prefer-dist --no-progress",
            "@lint:php:syntax",
            "@lint:phpcs:baseline"
        ],
        "lint:phpstan:baseline:update": "@phpstan --generate-baseline=phpstan-baseline.neon --allow-empty-baseline",
        "test:php:integration": "vendor/bin/phpunit -c phpunit-integration.xml --fail-on-empty-test-suite",
        "test:integration": "@test:php:integration",
        "lint:php:syntax": [
            "Composer\\Config::disableProcessTimeout",
            "bash bin/extension-tooling.sh phplint.sh"
        ],
        "lint:php:fix": [
            "Composer\\Config::disableProcessTimeout",
            "phpcbf"
        ],
        "phpstan": "bash bin/extension-tooling.sh phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=2G",
        "test:php": [
            "Composer\\Config::disableProcessTimeout",
            "@test:php:unit",
            "@test:php:isolated"
        ],
        "test:php:unit": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit --fail-on-empty-test-suite"
        ],
        "test:php:isolated": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit -c tests/isolated/phpunit.xml.dist --fail-on-empty-test-suite"
        ]
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "changelogger": {
            "changelog": "changelog.txt",
            "changes-dir": "changelog",
            "types": {
                "add": "Add",
                "fix": "Fix",
                "tweak": "Tweak",
                "dev": "Dev"
            },
            "ordering": [
                "subheading"
            ],
            "formatter": {
                "class": "Automattic\\WooCommerce\\ExtensionTools\\Changelogger\\Changelog_Formatter",
                "title": "*** Changelog ***"
            },
            "versioning": "semver"
        }
    }
}
