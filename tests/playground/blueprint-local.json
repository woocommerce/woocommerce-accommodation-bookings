{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/edit.php?post_type=product",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login",
			"username": "admin"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "woocommerce"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "vfs",
				"path": "/tmp/woocommerce-bookings.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "woocommerce-accommodation-bookings/woocommerce-accommodation-bookings.php"
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/mu-plugins"
		},
		{
			"step": "cp",
			"fromPath": "/wordpress/wp-content/plugins/woocommerce-accommodation-bookings/tests/playground/preview.php",
			"toPath": "/wordpress/wp-content/mu-plugins/accommodation-bookings-preview.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require WP_PLUGIN_DIR . '/woocommerce-accommodation-bookings/tests/playground/setup.php';"
		}
	]
}
