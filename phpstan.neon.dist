includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    # Stubs of integrated plugins, from woocommerce/php-stubs (composer install --working-dir=tools/php-stubs).
    # Minimum version from WC_Accommodation_Dependencies; the PHPStan job checks they match.
    # minimum: includes/class-wc-accommodation-dependencies.php /is_bookings_above_or_equal_to_version\( '([0-9.]+)' \)/
    - tools/php-stubs/vendor/woocommerce/php-stubs/stubs/woocommerce-bookings/3.10.0.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    phpVersion: 70400
    bootstrapFiles:
        - phpstan-bootstrap.php
    dynamicConstantNames:
        - WC_BOOKINGS_VERSION
    parallel:
        maximumNumberOfProcesses: 2
    paths:
        - woocommerce-accommodation-bookings.php
        - includes
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
