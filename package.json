{
  "name": "woocommerce-accommodation-bookings",
  "title": "WooCommerce Accommodation Bookings",
  "version": "1.4.0",
  "packageManager": "pnpm@10.33.0",
  "description": "An accommodations add-on for the WooCommerce Bookings extension.",
  "author": "WooCommerce",
  "license": "GPL-3.0-or-later",
  "keywords": [],
  "homepage": "https://woocommerce.com/products/woocommerce-accommodation-bookings/",
  "repository": {
    "type": "git",
    "url": "https://github.com/woocommerce/woocommerce-accommodation-bookings.git"
  },
  "bugs": {
    "url": "https://woocommerce.com/my-account/create-a-ticket/"
  },
  "engines": {
    "node": "^24.22.3"
  },
  "config": {
    "wp_org_slug": "woocommerce-accommodation-bookings",
    "woo": {
      "zip": {
        "phpCompatibility": {
          "ruleset": "phpcs-compat.xml.dist"
        }
      },
      "makepot": {
        "exclude": [
          "tests",
          "src",
          "deploy"
        ]
      },
      "capabilities": {
        "js": true,
        "buildTests": true,
        "e2e": true,
        "isolated": true,
        "integration": true,
        "qit": true,
        "pluginCheck": true
      },
      "pluginCheck": {
        "excludeDirectories": [
          ".github",
          "node_modules",
          "vendor",
          "tests",
          "bin",
          "build",
          "assets",
          "tools",
          "changelog"
        ],
        "excludeFiles": [
          ".git",
          ".gitignore",
          ".gitattributes",
          ".nvmrc",
          ".wp-env.json",
          ".wp-env.test.json",
          ".stylelintrc.json",
          ".markdownlintignore",
          ".npmpackagejsonlintrc.json",
          ".prettierrc.js",
          ".coderabbit.yaml",
          "phpcs.xml.dist",
          "phpcs-compat.xml.dist",
          "phpstan.neon.dist",
          "phpstan-baseline.neon",
          "phpstan-bootstrap.php",
          "AGENTS.md",
          "CLAUDE.md",
          "DEVELOPER.md"
        ],
        "ignoreWarnings": false,
        "strict": true,
        "ignoreCodes": [
          "WordPress.DB.DirectDatabaseQuery.DirectQuery",
          "WordPress.DB.DirectDatabaseQuery.NoCaching",
          "WordPress.DateTime.RestrictedFunctions.date_date",
          "WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedClassFound",
          "WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound",
          "WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound",
          "WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound",
          "WordPress.Security.ValidatedSanitizedInput.InputNotSanitized",
          "plugin_header_nonexistent_domain_path",
          "trademarked_term"
        ]
      },
      "e2e": {
        "timeoutMinutes": 25,
        "privatePlugins": true
      },
      "integration": {
        "legs": [
          {
            "php": "8.4",
            "script": "test:php:integration",
            "coverage": true
          },
          {
            "php": "7.4",
            "wp": "minimum",
            "wc": "minimum",
            "script": "test:php:integration",
            "defaultOnly": true
          }
        ]
      },
      "privatePlugins": [
        {
          "slug": "woocommerce-bookings",
          "suites": [
            "integration"
          ],
          "dirEnv": "BOOKINGS_DIR"
        },
        {
          "slug": "woocommerce-product-addons",
          "suites": [
            "integration"
          ],
          "dirEnv": "ADDONS_DIR"
        }
      ],
      "phpLint": {
        "isolatedPhp": [
          "7.4",
          "8.4"
        ]
      },
      "pullRequests": {
        "privatePlugins": true
      },
      "versionPatterns": [
        {
          "pattern": "define( 'WC_ACCOMMODATION_BOOKINGS_VERSION', '%s'"
        }
      ],
      "release": {
        "target": "wordpress.org",
        "readmeChangelog": true,
        "wpOrgSlug": "woocommerce-accommodation-bookings"
      },
      "qit": {
        "plugins": "woocommerce-bookings"
      }
    }
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@playwright/test": "1.63.0",
    "@woocommerce/dependency-extraction-webpack-plugin": "^3.0.1",
    "@woocommerce/e2e-utils-playwright": "0.6.0",
    "@woocommerce/eslint-plugin": "4.1.0",
    "@woocommerce/extension-tooling": "1.0.0",
    "@wordpress/e2e-test-utils-playwright": "3.0.0",
    "@wordpress/env": "12.0.0",
    "@wordpress/prettier-config": "^2.8.0",
    "@wordpress/scripts": "36.1.0",
    "@wordpress/stylelint-config": "^25.0.0",
    "eslint-plugin-playwright": "2.12.0",
    "globals": "16.5.0",
    "mini-css-extract-plugin": "^2.9.0",
    "moment": "^2.30.1",
    "prettier": "npm:wp-prettier@^3.9.6",
    "webpack-remove-empty-scripts": "^1.0.4"
  },
  "scripts": {
    "build": "pnpm run build:webpack && pnpm run makepot",
    "build:zip": "woo-extension-tooling build-zip",
    "build:webpack": "wp-scripts build",
    "makepot": "woo-extension-tooling makepot",
    "phpcompat": "woo-extension-tooling phpcompat",
    "audit:npm": "pnpm audit --audit-level=high",
    "audit:composer": "composer audit --locked --no-plugins --no-scripts --abandoned=report --ignore-severity=low --ignore-severity=medium && composer --working-dir=tools/php-quality audit --locked --no-plugins --no-scripts --abandoned=report --ignore-severity=low --ignore-severity=medium",
    "lint:js": "wp-scripts lint-js --max-warnings 0",
    "lint:style": "wp-scripts lint-style src/css/frontend.scss --max-warnings 0",
    "lint:style-fix": "pnpm run lint:style --fix",
    "lint:md:docs": "wp-scripts lint-md-docs --dot",
    "changelog": "composer install --quiet && composer exec -- changelogger",
    "changelog:check": "bash bin/check_changelog.sh",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "check:js": "pnpm run lint:pkg-json && pnpm run lint:style && pnpm run lint:js",
    "env:test:e2e:seed": "bash ./tests/e2e/bin/initialize.sh",
    "env:dev:seed": "wp-env run cli bash wp-content/woo-extension-tooling/seed-dev.sh wp-content/bin/seed_dev_plugin.sh",
    "env:dev:reset": "woo-extension-env-dev-reset",
    "env:start": "pnpm run env:dev:start",
    "env:stop": "pnpm run env:dev:stop",
    "env:restart": "pnpm run env:dev:restart",
    "env:destroy": "pnpm run env:dev:destroy",
    "env:test:start": "woo-extension-env-start",
    "env:test:stop": "pnpm run wp-env:test stop",
    "env:test:destroy": "pnpm run wp-env:test destroy",
    "wp-env": "wp-env",
    "wp-env:test": "WP_ENV_PORT=${WP_ENV_TESTS_PORT:-8889} wp-env --config .wp-env.test.json",
    "wp-env:e2e": "WP_ENV_PORT=${WP_ENV_TESTS_PORT:-8889} wp-env --config .wp-env.e2e.json",
    "test:e2e-local": "export $(cat ./tests/e2e/config/.env | xargs) && pnpm run test:e2e",
    "test:e2e-codegen": "playwright codegen",
    "test:e2e:regression": "ACCOM_E2E_REGRESSION=1 pnpm run test:e2e",
    "test:e2e:regression:seed": "node -e \"require('./tests/e2e/utils/local').seed()\"",
    "lint:php": "composer run lint:php --",
    "lint:php:syntax": "composer run lint:php:syntax --",
    "lint:php:fix": "composer run lint:php:fix --",
    "phpstan": "composer run phpstan --",
    "test:php": "composer run test:php --",
    "test:php:unit": "composer run test:php:unit --",
    "test:php:isolated": "composer run test:php:isolated --",
    "test:php:integration": "composer run test:php:integration --",
    "test:php:env": "woo-extension-tooling phpunit direct phpunit.xml",
    "watch:build": "wp-scripts start",
    "lint:js:fix": "pnpm run lint:js --fix",
    "env:dev:start": "wp-env start",
    "env:dev:stop": "wp-env stop",
    "env:dev:restart": "wp-env destroy --force && wp-env start --update",
    "env:dev:destroy": "wp-env destroy",
    "test:e2e": "woo-extension-tooling e2e run",
    "test:e2e:with-env": "woo-extension-tooling e2e with-env",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:setup": "woo-extension-tooling e2e setup",
    "test:e2e:reset": "woo-extension-tooling e2e reset",
    "test:e2e:ui": "pnpm run test:e2e --ui",
    "test:e2e:debug": "pnpm run test:e2e --debug",
    "test:e2e:report": "playwright show-report tests/e2e/test-results/playwright-report",
    "check:php": "composer run check:php --",
    "lint": "pnpm run check:php && pnpm run check:js && pnpm run lint:md:docs",
    "test:build": "node --test bin/*.test.js",
    "test": "pnpm run test:php && pnpm run test:build"
  }
}
