{
  "name": "woocommerce-accommodation-bookings",
  "title": "WooCommerce Accommodation Bookings",
  "version": "1.4.0",
  "packageManager": "pnpm@10.33.0",
  "description": "An accommodations add-on for the WooCommerce Bookings extension.",
  "author": "WooCommerce",
  "license": "GPL-3.0-or-later",
  "keywords": [],
  "homepage": "https://woocommerce.com/products/woocommerce-accommodation-bookings/",
  "repository": {
    "type": "git",
    "url": "https://github.com/woocommerce/woocommerce-accommodation-bookings.git"
  },
  "bugs": {
    "url": "https://woocommerce.com/my-account/create-a-ticket/"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "config": {
    "wp_org_slug": "woocommerce-accommodation-bookings"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@playwright/test": "1.63.0",
    "@woocommerce/dependency-extraction-webpack-plugin": "^3.0.1",
    "@woocommerce/e2e-utils-playwright": "^0.2.1",
    "@woocommerce/eslint-plugin": "^4.0.0",
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "@wordpress/env": "12.0.0",
    "@wordpress/prettier-config": "^2.8.0",
    "@wordpress/scripts": "36.1.0",
    "@wordpress/stylelint-config": "^25.0.0",
    "eslint-plugin-playwright": "2.12.0",
    "globals": "16.5.0",
    "mini-css-extract-plugin": "^2.9.0",
    "moment": "^2.30.1",
    "prettier": "npm:wp-prettier@^3.9.6",
    "webpack-remove-empty-scripts": "^1.0.4"
  },
  "scripts": {
    "prebuild": "rm -rf ./vendor && composer install",
    "build": "pnpm run build:webpack && pnpm run makepot && pnpm run archive",
    "build:zip": "pnpm run build && mkdir -p deploy && mv $npm_package_name.zip deploy/",
    "build:webpack": "wp-scripts build",
    "start:webpack": "wp-scripts start",
    "build:dev": "composer install && pnpm run build:webpack && pnpm run makepot",
    "prearchive": "rm -rf ./vendor",
    "archive": "composer archive --file=$npm_package_name --format=zip",
    "postarchive": "rm -rf $npm_package_name && unzip $npm_package_name.zip -d $npm_package_name && rm $npm_package_name.zip && zip -r $npm_package_name.zip $npm_package_name && rm -rf $npm_package_name",
    "makepot": "WP_CLI_PHP_ARGS='-d memory_limit=2048M' ./vendor/bin/wp i18n make-pot . --exclude=tests,src",
    "phpcompat": "bash bin/phpcompat.sh",
    "audit:npm": "pnpm audit --audit-level=high",
    "audit:composer": "composer audit --locked --no-plugins --no-scripts --abandoned=report --ignore-severity=low --ignore-severity=medium && composer --working-dir=tools/php-quality audit --locked --no-plugins --no-scripts --abandoned=report --ignore-severity=low --ignore-severity=medium",
    "lint:js": "wp-scripts lint-js --max-warnings 0",
    "lint:js-fix": "pnpm run lint:js --fix",
    "lint:style": "wp-scripts lint-style src/css/frontend.scss --max-warnings 0",
    "lint:style-fix": "pnpm run lint:style --fix",
    "lint:md:docs": "wp-scripts lint-md-docs --dot",
    "changelog": "composer install --quiet && composer exec -- changelogger",
    "changelog:check": "bash bin/check_changelog.sh",
    "check-licenses": "wp-scripts check-licenses --ignore=@woocommerce/e2e-utils-playwright",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "env:test:e2e": "bash ./bin/acceptance.sh",
    "env:test:e2e:help": "bash ./bin/acceptance.sh help",
    "env:test:e2e:setup": "bash ./bin/acceptance.sh setup",
    "env:test:e2e:reset": "bash ./bin/acceptance.sh reset",
    "env:test:e2e:run": "bash ./bin/acceptance.sh run",
    "env:test:e2e:run:ui": "E2E_SHOW_UI=1 bash ./bin/acceptance.sh run",
    "env:test:e2e:seed": "bash ./tests/e2e/bin/initialize.sh",
    "env:dev:seed": "wp-env run cli bash wp-content/bin/seed_dev.sh",
    "env:dev:reset": "bash ./bin/env-dev-reset.sh",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:test:start": "bash ./bin/env-start.sh",
    "env:test:stop": "pnpm run wp-env:test stop",
    "env:test:destroy": "pnpm run wp-env:test destroy",
    "wp-env": "wp-env",
    "wp-env:test": "WP_ENV_PORT=${WP_ENV_TESTS_PORT:-8889} wp-env --config .wp-env.test.json",
    "test:e2e-local": "export $(cat ./tests/e2e/config/.env | xargs) && pnpm run env:test:e2e:run",
    "test:e2e-debug": "pnpm run env:test:e2e:run --debug",
    "test:e2e-codegen": "playwright codegen",
    "test:e2e-report": "playwright show-report tests/e2e/test-results/playwright-report",
    "test:e2e:regression": "ACCOM_E2E_REGRESSION=1 pnpm run env:test:e2e:run",
    "test:e2e:reset": "node -e \"require('./tests/e2e/utils/local').seed()\""
  }
}
